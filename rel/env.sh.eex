#!/bin/sh
# The release root is read-only when built with Nix (/nix/store), so the
# default $RELEASE_ROOT/tmp cannot be created. Put runtime state (run_erl
# pipes/logs) in /tmp unless the operator overrides RELEASE_TMP.
export RELEASE_TMP="${RELEASE_TMP:-/tmp/bacon_net}"

# Node cookie: set RELEASE_COOKIE in the environment to override, otherwise
# use the random cookie generated into the release at build time.
export RELEASE_COOKIE="${RELEASE_COOKIE:-$(cat "$RELEASE_ROOT/releases/COOKIE")}"
